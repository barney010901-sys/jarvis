# Copy to .env and fill in real values. Never commit .env.

# --- Auth (placeholder bearer token; replace with real auth in a later phase) ---
JARVIS_API_TOKEN=change-me-to-a-long-random-value

# --- AI provider (agent/provider/claude_provider.py) ---
# Required for the real ClaudeOrchestrator (Phase 2). If unset,
# JARVIS_USE_CLAUDE is ignored and the backend falls back to the Phase 1
# StubOrchestrator, logging a warning at startup.
ANTHROPIC_API_KEY=

# --- Database ---
# Required for Postgres-backed memory/knowledge/profile (Phase 2). If
# unreachable, the backend falls back to Phase 1's in-memory stores and
# logs a warning at startup — it does not crash.
DATABASE_URL=postgresql://jarvis:jarvis@localhost:5432/jarvis

# --- Server ---
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000
JARVIS_LOG_LEVEL=INFO

# --- CORS (comma-separated origins; * only for local dev) ---
JARVIS_CORS_ORIGINS=*

# --- Phase 2: model routing (agent/provider/router.py) ---
# "primary" = main reasoning model. "fast" = cheap/quick model used for the
# planner and low-stakes calls. "fallback" = used if primary fails/retries
# are exhausted. All three can be the same model ID.
JARVIS_MODEL_PRIMARY=claude-sonnet-5
JARVIS_MODEL_FAST=claude-haiku-4-5-20251001
JARVIS_MODEL_FALLBACK=claude-opus-5
CLAUDE_MAX_TOKENS=4096
CLAUDE_TIMEOUT_SECONDS=30
CLAUDE_MAX_RETRIES=2

# --- Phase 2: cost/token budget ---
# Soft daily budget in USD (advisory — see backend/app/cost/tracker.py).
TOKEN_BUDGET_DAILY_USD=5.0

# --- Phase 2: knowledge deduplication ---
KNOWLEDGE_SIMILARITY_THRESHOLD=0.82
KNOWLEDGE_MIN_CONFIDENCE_TO_SKIP_CLAUDE=0.85

# --- Phase 2: backing stack selection ---
# Set to false to force Phase 1 behavior (in-memory / stub orchestrator)
# even if Postgres/Claude are configured — useful for offline development.
JARVIS_USE_POSTGRES=true
JARVIS_USE_CLAUDE=true

# --- Phase 4: local model support (no API key -- see agent/provider/ollama_provider.py) ---
# Set JARVIS_USE_LOCAL_MODEL=true and JARVIS_USE_CLAUDE=false (leave
# ANTHROPIC_API_KEY empty) to run entirely against a local Ollama server
# instead of Claude. Requires Ollama already installed/running and the
# model already created -- see agent/provider/ollama/Modelfile.
JARVIS_USE_LOCAL_MODEL=false
JARVIS_LOCAL_MODEL_NAME=jarvis
JARVIS_LOCAL_MODEL_BASE_URL=http://localhost:11434
JARVIS_LOCAL_MODEL_TIMEOUT_SECONDS=120

# --- Phase 2: feature flags ---
FEATURE_MODEL_ROUTING=true
FEATURE_AUTO_KNOWLEDGE_EXTRACTION=true
FEATURE_CONTEXT_COMPRESSION=true
FEATURE_PROACTIVE_SUGGESTIONS=true
# Off by default: local-heuristic-only, but still an extra background
# process — see docs/DECISIONS.md ("Proactive learning defaults to off").
FEATURE_PROACTIVE_LEARNING=false
