# Copy to .env and fill in real values. Never commit .env.

# --- Auth (placeholder bearer token; replace with real auth in a later phase) ---
JARVIS_API_TOKEN=change-me-to-a-long-random-value

# --- AI provider (agent/provider/claude_provider.py) ---
# Not called by the orchestrator yet in Phase 1 — required only once Phase 2
# wires ClaudeProvider into the orchestrator.
ANTHROPIC_API_KEY=

# --- Database (not connected in Phase 1 — memory uses an in-memory store) ---
DATABASE_URL=postgresql://jarvis:jarvis@localhost:5432/jarvis

# --- Server ---
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000
JARVIS_LOG_LEVEL=INFO

# --- CORS (comma-separated origins; * only for local dev) ---
JARVIS_CORS_ORIGINS=*
